# Root ignore rules for DamiAgentInfra.
# Modules are self-contained and may extend these rules with their own
# local .gitignore files (e.g. alexandria/.gitignore).

# Rust build output
target/

# Node
node_modules/
dist/

# Logs
*.log

# OS noise
.DS_Store
Thumbs.db

# alexandria local index artifacts
.alexandria/index/
