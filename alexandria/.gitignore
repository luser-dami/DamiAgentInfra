/target/

# Generated index state (project library + pack libraries). The library *home*
# itself (.alexandria/alexandria.toml, .alexandria/knowledge/) is source and stays tracked.
**/.alexandria/index/
**/packs/*/.alexandria/

# Local-only configuration overrides
/alexandria.local.toml

# Editor and platform files
/.idea/
/.vscode/
.DS_Store
Thumbs.db

# Logs and temporary files
*.log
*.tmp
*.bak
